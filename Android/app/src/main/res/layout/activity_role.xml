<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_bg" android:scaleType="centerCrop" android:alpha="0.78" android:contentDescription="Shadow Realm night landscape"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/realm_topbar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginTop="12dp" android:background="@drawable/realm_panel">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR SECRET ROLE" android:textColor="@color/realm_purple_bright" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.10" android:gravity="center"/>
        <TextView android:id="@+id/tvRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VILLAGER" android:textColor="@color/realm_text" android:textSize="38sp" android:textStyle="bold" android:fontFamily="serif" android:gravity="center" android:layout_marginTop="10dp"/>
        <TextView android:id="@+id/tvRoleTagline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trust your instincts. Find the traitor." android:textColor="@color/realm_muted" android:textSize="14sp" android:gravity="center" android:layout_marginTop="6dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="@drawable/realm_divider"/>
        <TextView android:id="@+id/tvRolePower" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POWER" android:textColor="@color/realm_purple_bright" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="18dp"/>
        <TextView android:id="@+id/tvRoleDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Discuss, investigate and vote wisely." android:textColor="@color/realm_lilac" android:textSize="15sp" android:layout_marginTop="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KEEP THIS ROLE SECRET" android:textColor="@color/realm_gold" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="24dp"/>
        <Button android:id="@+id/btnContinueRole" android:layout_width="match_parent" android:layout_height="57dp" android:layout_marginTop="12dp" android:text="CONTINUE TO THE NIGHT  ✦" android:textColor="@color/realm_text" android:textStyle="bold" android:background="@drawable/realm_button"/>
    </LinearLayout>
</LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>