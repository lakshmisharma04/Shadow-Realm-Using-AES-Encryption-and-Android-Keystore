<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_bg" android:scaleType="centerCrop" android:alpha="0.78" android:contentDescription="Shadow Realm night landscape"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/realm_topbar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="12dp" android:background="@drawable/realm_panel">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WELCOME, PLAYER" android:textColor="@color/realm_muted" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.10"/>
        <TextView android:id="@+id/tvWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your next story begins here." android:textColor="@color/realm_text" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif" android:layout_marginTop="4dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Build a room, gather your circle, uncover the traitor, and survive the night." android:textColor="@color/realm_muted" android:textSize="14sp" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <Button android:id="@+id/btnQuickStart" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="16dp" android:text="☾  SOLO PRACTICE • OFFLINE DEMO" android:textColor="@color/realm_text" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/realm_button"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR NEXT MOVE" android:textColor="@color/realm_text" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="23dp"/>
    <Button android:id="@+id/btnCreateRoom" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="✦  CREATE ONLINE REALM" android:textColor="@color/realm_text" android:textStyle="bold" android:background="@drawable/realm_button"/>
    <Button android:id="@+id/btnJoinRoom" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:text="⚔  JOIN ONLINE REALM" android:textColor="@color/realm_lilac" android:textStyle="bold" android:background="@drawable/realm_button_dark"/>
    <Button android:id="@+id/btnRules" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="15dp" android:text="✧  HOW THE GAME WORKS" android:textColor="@color/realm_purple_bright" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/realm_button_dark"/>
    <Button android:id="@+id/btnHistory" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:text="📜  MATCH HISTORY" android:textColor="@color/realm_purple_bright" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/realm_button_dark"/>
    <Button android:id="@+id/btnProfile" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:text="◈  MY IDENTITY &amp; SECURITY" android:textColor="@color/realm_purple_bright" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/realm_button_dark"/>
    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:text="LEAVE THE REALM" android:textColor="#D9CFE0" android:textSize="11sp" android:background="@drawable/realm_button_danger"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="☾  Trust is a weapon. Use it carefully." android:textColor="#82768E" android:textSize="12sp" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
</LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>