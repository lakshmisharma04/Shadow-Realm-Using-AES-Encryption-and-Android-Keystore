<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_bg" android:scaleType="centerCrop" android:alpha="0.78" android:contentDescription="Shadow Realm night landscape"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <include layout="@layout/realm_topbar"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="21dp" android:layout_marginTop="12dp" android:background="@drawable/realm_panel">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MATCH HISTORY" android:textColor="@color/realm_text" android:textSize="27sp" android:textStyle="bold" android:fontFamily="serif" android:gravity="center"/>
                <TextView android:id="@+id/tvHistoryStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading your past realms…" android:textColor="@color/realm_muted" android:textSize="14sp" android:gravity="center" android:layout_marginTop="8dp"/>
                <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp"/>
                <Button android:id="@+id/btnHistoryHome" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:text="RETURN TO THE REALM" android:textColor="@color/realm_lilac" android:textSize="12sp" android:background="@drawable/realm_button_dark" android:onClick="returnHome"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
