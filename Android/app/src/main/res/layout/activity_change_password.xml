<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_bg" android:scaleType="centerCrop" android:alpha="0.78" android:contentDescription="Shadow Realm night landscape"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/realm_topbar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="21dp" android:layout_marginTop="12dp" android:background="@drawable/realm_panel">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHANGE PASSWORD" android:textColor="@color/realm_text" android:textSize="25sp" android:textStyle="bold" android:fontFamily="serif"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create a stronger key for your identity." android:textColor="@color/realm_muted" android:textSize="14sp" android:layout_marginTop="7dp"/>
        <EditText android:id="@+id/currentPassword" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:background="@drawable/realm_input" android:hint="  Current password" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textPassword"/>
        <EditText android:id="@+id/newPassword" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/realm_input" android:hint="  New password" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textPassword"/>
        <EditText android:id="@+id/confirmNewPassword" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/realm_input" android:hint="  Confirm new password" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textPassword"/>
        <Button android:id="@+id/changePasswordBtn" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="SAVE NEW PASSWORD" android:textColor="@color/realm_text" android:textStyle="bold" android:background="@drawable/realm_button"/>
    </LinearLayout>
</LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>