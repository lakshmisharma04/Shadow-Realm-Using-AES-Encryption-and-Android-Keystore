<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_bg" android:scaleType="centerCrop" android:alpha="0.78" android:contentDescription="Shadow Realm night landscape"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include layout="@layout/realm_topbar"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="21dp" android:layout_marginTop="12dp" android:background="@drawable/realm_panel">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR IDENTITY" android:textColor="@color/realm_text" android:textSize="25sp" android:textStyle="bold" android:fontFamily="serif"/>
        <TextView android:id="@+id/tvProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Player" android:textColor="@color/realm_purple_bright" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/tvProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="player@realm.local" android:textColor="@color/realm_muted" android:textSize="13sp" android:layout_marginTop="4dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="@drawable/realm_divider"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SECURITY STATUS" android:textColor="@color/realm_purple_bright" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="17dp"/>
        <TextView android:id="@+id/tvSecurity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  Local token storage protected by Android Keystore" android:textColor="@color/realm_success" android:textSize="14sp" android:layout_marginTop="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SESSION" android:textColor="@color/realm_purple_bright" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="18dp"/>
        <TextView android:id="@+id/tvSession" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Demo session" android:textColor="@color/realm_lilac" android:textSize="14sp" android:layout_marginTop="6dp"/>
        <Button android:id="@+id/btnChangePassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="17dp" android:text="CHANGE PASSWORD" android:textColor="@color/realm_lilac" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/realm_button_dark"/>
    </LinearLayout>
</LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>