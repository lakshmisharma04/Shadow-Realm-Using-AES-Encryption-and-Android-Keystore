<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_bg" android:scaleType="centerCrop" android:alpha="0.78"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <include layout="@layout/realm_topbar"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginTop="14dp" android:background="@drawable/realm_panel">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PRIVATE INTELLIGENCE" android:textColor="@color/realm_gold" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.10"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR SECRET" android:textColor="@color/realm_text" android:textSize="29sp" android:textStyle="bold" android:fontFamily="serif" android:gravity="center" android:layout_marginTop="8dp"/>
          <TextView android:id="@+id/tvSecretValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="••••••••" android:textColor="@color/realm_purple_bright" android:textSize="24sp" android:textStyle="bold" android:gravity="center" android:padding="22dp" android:layout_marginTop="20dp" android:background="@drawable/realm_panel_soft"/>
          <TextView android:id="@+id/tvSecretCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Only you should see this." android:textColor="@color/realm_muted" android:textSize="13sp" android:gravity="center" android:layout_marginTop="15dp"/>
          <Button android:id="@+id/btnRevealSecret" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="18dp" android:text="REVEAL SECRET" android:textColor="@color/realm_lilac" android:textStyle="bold" android:background="@drawable/realm_button_dark"/>
          <Button android:id="@+id/btnContinueSecret" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:text="ENTER THE NIGHT  ✦" android:textColor="@color/realm_text" android:textStyle="bold" android:background="@drawable/realm_button"/>
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
</FrameLayout>