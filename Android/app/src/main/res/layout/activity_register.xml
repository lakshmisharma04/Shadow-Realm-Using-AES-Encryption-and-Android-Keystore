<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/realm_bg">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shadow_realm_login_bg" android:scaleType="centerCrop" android:contentDescription="Shadow Realm hooded guardian beneath a purple moon"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/realm_scrim"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <include layout="@layout/realm_topbar"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="23dp" android:layout_marginTop="12dp" android:background="@drawable/realm_panel">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CREATE YOUR IDENTITY" android:textColor="@color/realm_text" android:textSize="26sp" android:textStyle="bold" android:fontFamily="serif" android:gravity="center"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="One identity. One password. Your own place in the realm." android:textColor="@color/realm_muted" android:textSize="14sp" android:gravity="center" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REALM NAME" android:textColor="@color/realm_purple_bright" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="23dp"/>
                <EditText android:id="@+id/fullname" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/realm_input" android:hint="  choose your realm name" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textPersonName" android:singleLine="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EMAIL / LOGIN ID" android:textColor="@color/realm_purple_bright" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="13dp"/>
                <EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/realm_input" android:hint="  your@email.com" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textEmailAddress" android:singleLine="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PASSWORD" android:textColor="@color/realm_purple_bright" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="13dp"/>
                <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/realm_input" android:hint="  at least 6 characters" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textPassword" android:singleLine="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONFIRM PASSWORD" android:textColor="@color/realm_purple_bright" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginTop="13dp"/>
                <EditText android:id="@+id/confirmPassword" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:background="@drawable/realm_input" android:hint="  repeat your password" android:textColor="@color/realm_text" android:textColorHint="#8E849B" android:inputType="textPassword" android:singleLine="true"/>
                <Button android:id="@+id/register" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="19dp" android:text="CREATE IDENTITY  ✦" android:textColor="@color/realm_text" android:textStyle="bold" android:background="@drawable/realm_button"/>
                <TextView android:id="@+id/backToLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already have an identity?  Sign in" android:textColor="@color/realm_purple_bright" android:textSize="13sp" android:layout_gravity="center" android:layout_marginTop="15dp" android:clickable="true" android:focusable="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✦  PASSWORDS ARE HASHED BY THE SPRING BOOT BACKEND" android:textColor="#82768E" android:textSize="9sp" android:gravity="center" android:layout_marginTop="14dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
